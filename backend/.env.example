DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpass
# Where the React app runs; allowed by CORS on the REST API.
FRONTEND_ORIGIN=http://localhost:5173
# Optional, not used by the website now: Google OAuth client ID, only needed
# if you turn traveller sign-in ("Sign in with Google") back on.
# Create it at https://console.cloud.google.com/apis/credentials and add your
# frontend URL (e.g. http://localhost:5173) under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
